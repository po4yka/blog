{
  "name": "blog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "tsx scripts/generate-all-data.ts && astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:ts6 && npm run typecheck:ts7 && npm run typecheck:astro",
    "typecheck:ts6": "tsc6 --noEmit --stableTypeOrdering -p tsconfig.json && tsc6 --noEmit --stableTypeOrdering -p tsconfig.scripts.json",
    "typecheck:ts7": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:astro": "astro check",
    "test": "vitest run",
    "test:mcp-http": "node scripts/verify-mcp-node-server.mjs",
    "test:watch": "vitest",
    "generate:blog": "tsx scripts/generate-blog-data.ts",
    "generate:all": "tsx scripts/generate-all-data.ts",
    "scan:complexity": "tsx scripts/scan-complexity.ts",
    "validate:blog": "tsx scripts/validate-blog-sync.ts",
    "validate:skills": "bash scripts/validate-skills.sh",
    "validate:all": "tsx scripts/validate-all-sync.ts",
    "setup:passkey": "tsx scripts/setup-passkey.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lighthouse": "lhci autorun",
    "prepare": "simple-git-hooks",
    "indexnow": "node scripts/indexnow-submit.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx commitlint --edit $1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --no-warn-ignored"
    ],
    "{.claude,.agents}/skills/**": "bash scripts/validate-skills.sh",
    "scripts/apply-skill-policy.sh": "bash scripts/validate-skills.sh"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-query": "^5.105.0",
    "astro": "^7.4.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "satori": "^0.63.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "vite": "$vite",
    "esbuild": ">=0.28.1",
    "tmp": ">=0.2.6",
    "defu": ">=6.1.5",
    "basic-ftp": "6.2.1",
    "ws": ">=8.21.0",
    "qs": ">=6.16.1",
    "uuid": ">=11.1.1",
    "undici": "^7.30.1",
    "@babel/core": "^7.29.6",
    "@typescript/old": "npm:typescript@6.0.2",
    "body-parser@^1.0.0": "1.20.9",
    "brace-expansion@^5.0.0": "5.0.12",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.5.0",
    "fast-uri": "3.1.9",
    "fflate": "0.7.5",
    "ip-address": "10.7.4",
    "js-yaml@^3.0.0": "3.15.2",
    "js-yaml@^4.0.0": "4.3.2",
    "nanoid": "3.3.18",
    "sharp": "$sharp",
    "rehype-katex": {
      "katex": "$katex"
    },
    "micromark-extension-math": {
      "katex": "$katex"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@shikijs/transformers": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "geist": "^1.9.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.1",
    "lint-staged": "^17.6.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

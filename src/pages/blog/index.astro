---
import { getCollection, type CollectionEntry } from "astro:content";
import MainLayout from "@/layouts/MainLayout.astro";
import { BlogListIsland } from "@/components/blog/BlogListIsland";
import { parsePostId } from "@/lib/i18n";
import { compareNewestFirst, postIsoDate } from "@/lib/blog/dates";
import { readingMinutes } from "@/lib/reading";
import { blogPostsMeta } from "@/data/blogMeta";

const allPosts: CollectionEntry<"blog">[] = await getCollection("blog");

// Filter to English posts only
const posts = allPosts.filter((p) => parsePostId(p.id).lang === "en");

// Newest first by the ISO day; the "Mon YYYY" label parses in local time and ties within a month.
const sortKey = (p: CollectionEntry<"blog">) => ({ isoDate: postIsoDate(p.data) ?? "", slug: p.id });
posts.sort((a, b) => compareNewestFirst(sortKey(a), sortKey(b)));

const serializedPosts = posts.map((p) => {
  const { lang, baseSlug } = parsePostId(p.id);
  // The generated word count (code excluded), so the list and the post page show the same minutes,
  // and the outline the row's cover strip draws.
  const meta = blogPostsMeta.find((m) => m.slug === baseSlug && m.lang === lang);
  const wordCount = meta?.wordCount;
  return { slug: baseSlug, ...p.data, outline: meta?.outline, readingTime: readingMinutes({ readingTime: p.data.readingTime, wordCount }) ?? 1 };
});

const categories = [
  "All",
  ...new Set(posts.map((p) => p.data.category)),
];
const blogIndexHreflang = [
  { hreflang: "en", href: "https://po4yka.dev/blog" },
  { hreflang: "ru", href: "https://po4yka.dev/blog/ru" },
  { hreflang: "x-default", href: "https://po4yka.dev/blog" },
];
---
<MainLayout title="Blog — Nikita Pochaev" description="Technical writing on Android, Kotlin Multiplatform, MobileOps, and AI integration — by Nikita Pochaev, mobile engineer." hreflangAlternates={blogIndexHreflang}>
  <BlogListIsland client:load posts={serializedPosts} categories={categories} />
</MainLayout>

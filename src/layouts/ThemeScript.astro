---
// Inline script that runs synchronously before paint to prevent FOUC.
// Reads preferences from localStorage and applies .dark/.light, data-motion
// the effects level and the font size to <html>.
import { THEME_COLORS } from "@/lib/themeColors";
const { nonce } = Astro.locals;
---
<script is:inline nonce={nonce} define:vars={{ themeColors: THEME_COLORS }}>
(function() {
  var prefs = {};
  try {
    var raw = localStorage.getItem('site_preferences');
    var stored = raw ? JSON.parse(raw) : {};
    prefs = stored.state || stored;
  } catch(e) {}
  // Reduced motion first, so a bad theme value cannot skip it. OS or stored flag.
  if (prefs.reduceMotion || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.setAttribute('data-motion', 'reduce');
  }
  // Grid guides default on; only an explicit false hides them.
  if (prefs.gridGuides === false) document.documentElement.setAttribute('data-grid', 'off');
  // Effects: no attribute means full. Islands read only this attribute.
  if (prefs.effects === 'reduced' || prefs.effects === 'off') document.documentElement.setAttribute('data-effects', prefs.effects);
  // Locale before paint, so static sections show the stored language with no flash.
  var locale = prefs.locale === 'ru' ? 'ru' : 'en';
  document.documentElement.setAttribute('data-locale', locale);
  if (location.pathname.indexOf('/blog') !== 0) document.documentElement.lang = locale;
  try {
    var theme = prefs.theme || 'system';
    var resolved = theme === 'system'
      ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
      : theme;
    document.documentElement.classList.add(resolved);
    if (prefs.fontSize) {
      var sizes = { compact: '15px', 'default': '16px', large: '17px' };
      var size = sizes[prefs.fontSize];
      if (size) document.documentElement.style.setProperty('--font-size', size);
    }
    // BaseHead's two static theme-color tags only track OS preference via
    // `media`. An explicit light/dark override (not "system") needs its own
    // non-media tag kept in sync so the mobile browser chrome matches it too.
    var themeColorMeta = document.querySelector('meta[name="theme-color"]:not([media])');
    if (!themeColorMeta) {
      themeColorMeta = document.createElement('meta');
      themeColorMeta.setAttribute('name', 'theme-color');
      document.head.appendChild(themeColorMeta);
    }
    themeColorMeta.setAttribute('content', resolved === 'dark' ? themeColors.dark : themeColors.light);
  } catch(e) {}
})();
</script>
<script>
  import { applyReducedMotion } from "@/lib/motion";
  import { applyLocale } from "@/lib/localeDom";
  import { setThemeColor } from "@/lib/themeColors";
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client";

  // Blocked storage or a bad value means no preferences, as in the inline script above.
  function readPrefs() {
    try {
      const raw = localStorage.getItem("site_preferences");
      const stored = raw ? JSON.parse(raw) : {};
      return stored.state || stored;
    } catch {
      return {};
    }
  }

  function applyThemeClass(root: HTMLElement, resolved: string) {
    root.classList.toggle("dark", resolved === "dark");
    root.classList.toggle("light", resolved === "light");
  }

  function resolveTheme(prefs: { theme?: string }): string {
    const theme = prefs.theme || "system";
    if (theme !== "system") return theme;
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  // The swap copies <html> attributes from the incoming page. Put the theme class there first:
  // with no class for one style pass, <body> starts its colour transition from the light theme.
  function applyThemeToIncoming(event: TransitionBeforeSwapEvent) {
    applyThemeClass(event.newDocument.documentElement, resolveTheme(readPrefs()));
  }

  // Re-apply the other preferences after the View Transition DOM swap, which resets <html> attributes.
  function applyPrefsFromStorage() {
    try {
      const prefs = readPrefs();
      applyReducedMotion(!!prefs.reduceMotion);
      applyLocale(prefs.locale === "ru" ? "ru" : "en");
      if (prefs.gridGuides === false) document.documentElement.setAttribute("data-grid", "off");
      else document.documentElement.removeAttribute("data-grid");
      if (prefs.effects === "reduced" || prefs.effects === "off") document.documentElement.setAttribute("data-effects", prefs.effects);
      else document.documentElement.removeAttribute("data-effects");
      const sizes: Record<string, string> = { compact: "15px", default: "16px", large: "17px" };
      const size = sizes[prefs.fontSize];
      if (size) document.documentElement.style.setProperty("--font-size", size);
      // Again here: the fallback animation runs between the two events, and the theme can change in it.
      const resolved = resolveTheme(prefs);
      applyThemeClass(document.documentElement, resolved);
      setThemeColor(resolved === "dark" ? "dark" : "light");
    } catch {}
  }
  document.addEventListener("astro:before-swap", applyThemeToIncoming);
  document.addEventListener("astro:after-swap", applyPrefsFromStorage);
</script>

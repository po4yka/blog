---
// Blog figure with art-direction variants (desktop/mobile × light/dark)
// and per-variant format conversion (AVIF/WebP/PNG) via astro:assets.
// SVG variants (havamal figures with render-format svg) ship as-is: one
// image/svg+xml source per art direction, no raster conversion. The SVG
// embeds its own fonts and declares a 2x intrinsic width/height, which the
// lightbox reads as the natural size.
// Callers pass ImageMetadata directly (via a generated manifest module)
// because import.meta.glob does not resolve when this component renders
// as a slotted child of a React island in Astro 7.

import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Variants {
  desktopLight: ImageMetadata;
  desktopDark: ImageMetadata;
  // Optional: articles authored without mobile canonicals ship no mobile
  // renders, so the generated manifest omits these. Fall back to desktop.
  mobileLight?: ImageMetadata;
  mobileDark?: ImageMetadata;
}

interface Props {
  variants: Variants;
  alt: string;
  caption?: string;
  /** Mark the first figure in a post as the LCP candidate.
   *  Outputs loading="eager" decoding="sync" fetchpriority="high".
   *  Pass eager={true} on the first <BlogFigure> in each MDX post. */
  eager?: boolean;
}

const { variants, alt, caption, eager = false } = Astro.props;

const FORMATS = ["avif", "webp", "png"] as const;

const isSvg = (image: ImageMetadata): boolean => image.format === "svg";

// Mobile renders are optional. When an article ships none, the manifest
// leaves mobileLight/mobileDark undefined; reuse the desktop render for the
// narrow-viewport media queries so every <source> still resolves an image.
const mobileDark = variants.mobileDark ?? variants.desktopDark;
const mobileLight = variants.mobileLight ?? variants.desktopLight;

const ART_DIRECTIONS: Array<{
  media: string;
  src: ImageMetadata;
  theme: "dark" | "light";
  viewport: "mobile" | "desktop";
}> = [
  {
    media: "(prefers-color-scheme: dark) and (max-width: 640px)",
    src: mobileDark,
    theme: "dark",
    viewport: "mobile",
  },
  {
    media: "(max-width: 640px)",
    src: mobileLight,
    theme: "light",
    viewport: "mobile",
  },
  {
    media: "(prefers-color-scheme: dark)",
    src: variants.desktopDark,
    theme: "dark",
    viewport: "desktop",
  },
];

type FigureSource = {
  srcset: string;
  type: "image/svg+xml" | `image/${(typeof FORMATS)[number]}`;
  media: string;
  theme: "dark" | "light";
  viewport: "mobile" | "desktop";
};

// An SVG source is ready at once; a raster one is a getImage() promise per format.
const sources: FigureSource[] = await Promise.all(
  ART_DIRECTIONS.flatMap((direction): Array<FigureSource | Promise<FigureSource>> => {
    if (isSvg(direction.src)) {
      return [
        {
          srcset: direction.src.src,
          type: "image/svg+xml" as const,
          media: direction.media,
          theme: direction.theme,
          viewport: direction.viewport,
        },
      ];
    }
    return FORMATS.map(async (format) => {
      const processed = await getImage({
        src: direction.src,
        format,
        quality: 85,
      });
      return {
        srcset: processed.src,
        type: `image/${format}` as const,
        media: direction.media,
        theme: direction.theme,
        viewport: direction.viewport,
      };
    });
  }),
);

const fallback = isSvg(variants.desktopLight)
  ? {
      src: variants.desktopLight.src,
      attributes: { width: variants.desktopLight.width, height: variants.desktopLight.height },
    }
  : await getImage({ src: variants.desktopLight, format: "png" });

// Authored captions open with "Figure 3." / "Рисунок 3." (havamal sync).
// Lift that number into a field code in the InfoTable voice, FIG 03, and
// keep the rest of the sentence as the caption. Captions without a number
// render as plain text; the content, not a CSS counter, stays authoritative.
const captionMatch = caption?.match(/^\s*(?:Figure|Fig\.?|Рисунок|Рис\.?)\s*(\d+)\s*[.:]?\s*/i);
const figCode = captionMatch ? `FIG ${captionMatch[1]!.padStart(2, "0")}` : null;
const captionText = captionMatch && caption ? caption.slice(captionMatch[0].length) : caption;
---

<figure class="blog-figure">
  {/* AnatomyFigure puts its live plate here, inside the figure with the caption. */}
  <slot />
  <picture data-theme-aware>
    {sources.map((source) => (
      <source
        srcset={source.srcset}
        type={source.type}
        media={source.media}
        data-theme={source.theme}
        data-viewport={source.viewport}
      />
    ))}
    <img
      src={fallback.src}
      alt={alt}
      width={fallback.attributes.width}
      height={fallback.attributes.height}
      loading={eager ? "eager" : "lazy"}
      decoding={eager ? "sync" : "async"}
      {...(eager ? { fetchpriority: "high" } : {})}
    />
  </picture>
  {caption && (
    <figcaption>
      {figCode && <span class="fig-code">{figCode}</span>}
      <em>{captionText}</em>
    </figcaption>
  )}
</figure>
